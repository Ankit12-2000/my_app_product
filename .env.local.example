# Copy this file to .env.local and fill in your Supabase project values.
# Until these are set, the app runs on built-in mock data so you can preview the UI.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key (never expose to the browser). Used for admin/server actions later.
SUPABASE_SERVICE_ROLE_KEY=
